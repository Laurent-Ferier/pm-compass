{
  "name": "pm-compass",
  "version": "1.2.2",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:dev": "node esbuild.config.mjs --dev",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "node scripts/smoke-bundle.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts'",
    "release": "node scripts/release.mjs",
    "docs:diagrams": "node scripts/render-diagrams.mjs",
    "docs:diagrams:check": "node scripts/render-diagrams.mjs --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "moment": "^2.29.4",
    "obsidian": "latest",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.62.0",
    "vitest": "^3.0.0"
  }
}
