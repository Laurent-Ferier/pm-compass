---
title: Files — the IO layer
---
classDiagram
  direction TB

  class BaseIO~Fields, Edit~ {
    <<abstract>>
    +filePath
    +fill(fields) bool
    +snapshot() Fields
    +attach(model) / detach(model)
    +set(field, value)
    +flush()
    #owe(key, edit)
    #writeOwed(owed)*
    #markStale()
  }

  class ListingIO~Fields~ {
    <<abstract>>
    +readListing(cache)
    +syncChildBoxes()
    +isVerified / markVerified()
    +addChild() / removeChild()
    +syncChildListing(children)
    #childSection*
    #childFolder*
  }

  class ProjectIO {
    +readMetadata()
    childSection = ## Tasks
  }

  class ProjectTaskIO {
    +readSubtaskIds()
    +update(data)
    +ensureListed()
    +applyParentBox(checked)
    +stampCompleted()
    childSection = ## Subtasks
  }

  class TaskIO {
    +read() / parsedTasks()
    +tasks(): KeyedTask[]
    +taskFor(key)
    +originalKey(key)
    +owePass(key, kind, edit)
    -owedNow(key, kind, mutate)
    -pass(mutate)
    +addLine() / removeLine()
    +setLineChecked() / setLineTitle()
    +moveLineBefore() / insertUnderHeading()
    +withLineChecked() / withoutLine()
  }

  class lineAlgebra["line algebra"] {
    <<in task-io.ts>>
    +parseTasksFromLines(lines, path)
    +withTaskAdded() / withoutTask()
    +withChecked() / withTitleSet()
    +withGroupUnderHeading()
    +withTaskMovedBefore()
  }

  note for BaseIO "Fields — what this kind of note parses to, its whole reading<br/>Edit — one change owed to the vault, gathered by owe() and applied by writeOwed()"

  BaseIO <|-- ListingIO
  BaseIO <|-- TaskIO : Fields = TaskIOFields, Edit = LineEdit
  ListingIO <|-- ProjectIO : Fields = ProjectFields
  ListingIO <|-- ProjectTaskIO : Fields = ProjectTaskFields

  BaseIO ..> IModel : wakes the models attached
  ListingIO ..> ProjectTaskIO : registers a child through
  TaskIO ..> lineAlgebra : what to make of the lines it read
  TaskIO "1" --> "*" Task : keys a line to
